# Copy to .env and adjust. docker compose reads this file.

APP_NAME=Atrium
API_PORT=8000
WEB_PORT=3000
ADMIN_PORT=3001

# Host Ollama is bound to 127.0.0.1:11434. The API uses host networking
# so it can reach that address without exposing Ollama on the LAN.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:32b
# Optional: pull `nomic-embed-text` and set this to use Ollama for embeddings.
# OLLAMA_EMBED_MODEL=nomic-embed-text

DOCUMENTS_DIR=/data/documents
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=atriumpass
LLM_PROVIDER=ollama
# ANTHROPIC_API_KEY=
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
WATCH_DOCUMENTS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WORKSPACE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_INTERNAL_URL=http://host.docker.internal:8000
DATABASE_URL=postgresql+psycopg://atrium:atrium@127.0.0.1:5432/atrium

# Mailroom (optional). When set, the Mailroom agent downloads PDF/XLSX/PPTX
# attachments from unseen mail into data/documents/inbox.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# IMAP_POLL_SECONDS=0

# Extractor uses heuristics by default so CPU Ollama is not blocked on every file.
# EXTRACT_WITH_LLM=false

# Courier / Telegram. Create a bot with @BotFather, then:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_POLL_SECONDS=0

# Scribe writes the generated roster into AGENTS.md and docs/HOW_IT_WORKS.md
DOCS_ROOT=/repo
# SYNC_DOCS=true
